{
  "name": "artificial-banking-inc",
  "private": true,
  "version": "0.1.0",
  "description": "Artificial Banking Incorporated \u2014 Financial OS for AI agents",
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/api-worker",
    "apps/mcp-server",
    "apps/worker",
    "apps/demo-agent",
    "apps/x402-seller",
    "apps/x402-seller-worker",
    "packages/common",
    "packages/custody",
    "packages/ledger",
    "packages/policy",
    "packages/sdk"
  ],
  "scripts": {
    "build": "npm run build -w @policyvault/common -w @policyvault/policy -w @policyvault/ledger -w @policyvault/custody -w @policyvault/sdk -w @policyvault/api -w @policyvault/x402-seller -w @policyvault/mcp-server -w @policyvault/worker -w @policyvault/web",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @policyvault/api",
    "dev:web": "npm run dev -w @policyvault/web",
    "dev:mcp": "npm run dev -w @policyvault/mcp-server",
    "dev:worker": "npm run dev -w @policyvault/worker",
    "demo:agent": "npm run start -w @policyvault/demo-agent",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm --prefix packages/db run generate",
    "db:reset": "node apps/api/scripts/reset-db.mjs",
    "db:backup": "node apps/api/scripts/backup-db.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "probe:stress": "node apps/api/scripts/stress-probe.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "vercel:harden": "node scripts/vercel-harden.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "zod": "4.6.7",
    "@cloudflare/vitest-plugin": {
      "zod": "4.6.7"
    },
    "@cloudflare/vitest-pool-workers": {
      "zod": "4.6.7"
    }
  },
  "packageManager": "npm@10",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0",
    "wrangler": "^4.152.0"
  }
}
