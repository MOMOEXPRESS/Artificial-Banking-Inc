{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node"],
    "lib": ["ES2022"],
    "noEmit": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/**/*",
    "test/**/*.node.test.ts",
    "vitest.config.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["test/spike.test.ts", "test/api.integration.test.ts", "node_modules", ".wrangler"]
}
