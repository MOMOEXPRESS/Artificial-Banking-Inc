  resolvedAt String? @map("resolved_at")
  resolvedBy String? @map("resolved_by")
  kind String?
  destination String?
  @@index([orgId])
  @@map("treasury_moves")
}

model UserMfa {
  userId String @id @map("user_id") // -> users.id
  secret String
  confirmedAt String? @map("confirmed_at")
  lastStep Int? @map("last_step")
