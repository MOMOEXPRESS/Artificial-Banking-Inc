# Copy to contracts/.env and fill in. Never commit .env.

# Deployer private key (test wallet only for Sepolia)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Receives the entire 1B ABINC supply at deploy — use a Safe/multisig on mainnet
TREASURY=0xYOUR_TREASURY_ADDRESS

# Public RPCs (defaults work; swap for Alchemy/Infura if you prefer)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# https://basescan.org/myapikey (works for Sepolia + mainnet verify)
BASESCAN_API_KEY=
