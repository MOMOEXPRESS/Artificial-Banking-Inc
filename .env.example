# Local development configuration. Put real deployment secrets in the host's
# secret manager rather than in this file.
PORT=8787
NODE_ENV=development
POLICYVAULT_DB=./apps/api/data/policyvault.db
ABI_KEY_PEPPER=
ABI_KEK=

# Console and API
# Browser code always uses same-origin /abi-api (ignore absolute URLs there).
# Server proxy uses ABI_API_ORIGIN.
NEXT_PUBLIC_API_URL=/abi-api
ABI_API_ORIGIN=http://localhost:8787
# Required in production for verification/invite/reset links (no localhost fallback).
ABI_CONSOLE_URL=http://localhost:3000
ABI_CORS_ORIGINS=

# Authentication and approval settings
ABI_SESSION_TTL_HOURS=12
ABI_STEP_UP_ABOVE_USDC=100
ABI_STEP_UP_TTL_MINUTES=5
ABI_SIGNUP_TOKEN=
ABI_SIGNUP_LIMIT_PER_HOUR=10
# Testnet-only: allow signup without sending verification email. Refused when CHAIN=base.
# ABI_ALLOW_UNVERIFIED_SIGNUP=1

# Chain and notifications
CHAIN=base-sepolia
CHAIN_RPC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# Email (required for production signup unless ABI_ALLOW_UNVERIFIED_SIGNUP=1 on testnet)
# Primary free path: Brevo transactional HTTP API (plain fetch). Free plan verifies one
# sender email — no custom domain. Create an API key in Brevo → SMTP & API → API keys.
BREVO_API_KEY=
# Must be the Brevo-verified sender, e.g. you@gmail.com or ABI <you@gmail.com>
ABI_NOTIFY_EMAIL_FROM=
# Optional fallback (Resend without a verified domain only delivers to the account owner)
RESEND_API_KEY=
# Optional Node SMTP path (e.g. Brevo relay smtp-relay.brevo.com:587) if not using BREVO_API_KEY
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
ABI_NOTIFY_EMAIL_TO=
SLACK_WEBHOOK_URL=

# Optional public x402 seller for Playground missions (hosted consoles must set this;
# localhost:9402 is only used automatically on local next dev).
NEXT_PUBLIC_SELLER_URL=

# Operations
ABI_RUN_JOBS=1
ABI_GAS_WARN_ETH=0.002
ABI_SETTLEMENT_STUCK_MINUTES=10
ABI_GAS_RENOTIFY_HOURS=6
ABI_COMPLIANCE_DENYLIST=
ABI_COMPLIANCE_WEBHOOK_URL=
RATE_LIMIT_PER_MIN=5000
APPROVAL_TTL_MINUTES=60
