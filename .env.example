# Local development configuration. Put real deployment secrets in the host's
# secret manager rather than in this file.
PORT=8787
NODE_ENV=development
POLICYVAULT_DB=./apps/api/data/policyvault.db
ABI_KEY_PEPPER=
ABI_KEK=

# Console and API
NEXT_PUBLIC_API_URL=/abi-api
ABI_API_ORIGIN=http://localhost:8787
ABI_CONSOLE_URL=http://localhost:3000
ABI_CORS_ORIGINS=

# Authentication and approval settings
ABI_SESSION_TTL_HOURS=12
ABI_STEP_UP_ABOVE_USDC=100
ABI_STEP_UP_TTL_MINUTES=5
ABI_SIGNUP_TOKEN=
ABI_SIGNUP_LIMIT_PER_HOUR=10

# Chain and notifications
CHAIN=base-sepolia
CHAIN_RPC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
RESEND_API_KEY=
ABI_NOTIFY_EMAIL_FROM=
ABI_NOTIFY_EMAIL_TO=
SLACK_WEBHOOK_URL=

# Operations
ABI_RUN_JOBS=1
ABI_GAS_WARN_ETH=0.002
ABI_SETTLEMENT_STUCK_MINUTES=10
ABI_GAS_RENOTIFY_HOURS=6
ABI_COMPLIANCE_DENYLIST=
ABI_COMPLIANCE_WEBHOOK_URL=
RATE_LIMIT_PER_MIN=5000
APPROVAL_TTL_MINUTES=60
