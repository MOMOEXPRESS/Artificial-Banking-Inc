# Local development configuration. Put real deployment secrets in the host's
# secret manager rather than in this file.
#
# Production refuses to boot without ABI_KEY_PEPPER + ABI_KEK, and refuses
# demo/bootstrap, public org-create, mock transfer, and local SSRF targets
# unless ABI_ALLOW_UNSAFE_PROD=1 (disposable demos only — never real funds).

PORT=8787
NODE_ENV=development
POLICYVAULT_DB=./apps/api/data/policyvault.db

# Required in production (32+ random bytes each). Never reuse ABI_SIGNUP_TOKEN.
# Demo/bootstrap can auto-generate independent secrets under the DB directory
# when POLICYVAULT_ALLOW_BOOTSTRAP=1 (written to abi-demo-secrets.json).
ABI_KEY_PEPPER=
ABI_KEK=
ABI_DEMO_SECRETS_PATH=
# ABI_DEMO_DERIVE_FROM_SIGNUP_TOKEN=1  # unsafe legacy escape hatch — do not use
# ABI_ALLOW_UNSAFE_PROD=1             # allow demo flags in NODE_ENV=production

# Console and API
NEXT_PUBLIC_API_URL=/abi-api
ABI_API_ORIGIN=http://localhost:8787
ABI_CONSOLE_URL=http://localhost:3000
ABI_CORS_ORIGINS=

# Authentication and approval settings
ABI_SESSION_TTL_HOURS=12
ABI_STEP_UP_ABOVE_USDC=100
ABI_STEP_UP_TTL_MINUTES=5
ABI_SIGNUP_TOKEN=
ABI_SIGNUP_LIMIT_PER_HOUR=10

# Demo / destructive gates (keep off in production)
POLICYVAULT_ALLOW_BOOTSTRAP=0
POLICYVAULT_ALLOW_PUBLIC_ORG_CREATE=0
POLICYVAULT_MOCK_TRANSFER=0
ABI_ALLOW_LOCAL_TARGETS=0
ABI_NO_LISTEN=0
ABI_RUN_JOBS=1

# Chain and on-chain self-custody (not Coinbase CDP)
CHAIN=base-sepolia
CHAIN_RPC_URL=
ABI_ONCHAIN_ENABLED=0
ABI_X402_NETWORKS=

# Telegram approvals (per-org settings.telegramChatId preferred)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# Notifications (optional — log stub when unset)
RESEND_API_KEY=
ABI_NOTIFY_EMAIL_FROM=
ABI_NOTIFY_EMAIL_TO=
SLACK_WEBHOOK_URL=

# Operations
ABI_LOG_LEVEL=info
RATE_LIMIT_PER_MIN=5000
APPROVAL_TTL_MINUTES=10
ESCROW_TIMEOUT_MINUTES=15
ABI_GAS_WARN_ETH=0.002
ABI_SETTLEMENT_STUCK_MINUTES=10
ABI_GAS_RENOTIFY_HOURS=6
ABI_COMPLIANCE_DENYLIST=
ABI_COMPLIANCE_WEBHOOK_URL=
ABI_COMPLIANCE_FAIL_CLOSED=1
WORKER_HEALTH_PORT=8788
