# Environment (example) — Artificial Banking Inc

# --- Core ---
PORT=8787
NODE_ENV=development
POLICYVAULT_DB=./apps/api/data/policyvault.db
# Strong random string in production (A13 key hashing pepper)
ABI_KEY_PEPPER=change-me-in-production

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8787
POLICYVAULT_API_URL=http://localhost:8787

# --- Demo / bootstrap ---
# WARNING: /v1/demo/bootstrap is UNAUTHENTICATED and DELETES EVERY ORG in the
# database, including vault private keys. Never enable it on a deployment that
# anyone else can reach. Roadmap P1-T1 removes the endpoint entirely.
POLICYVAULT_ALLOW_BOOTSTRAP=0
# Unauthenticated org creation hands out root guardian keys to anyone. Keep off
# in production; roadmap P1-T4 / P3-T1 replace it with invite-gated signup.
POLICYVAULT_ALLOW_PUBLIC_ORG_CREATE=0

# --- Custody / chain (go-live) ---
# NOTE: setting these does NOT enable Coinbase custody. There is no Coinbase
# integration in this codebase. They only switch the signer from DevLocalProvider
# to SelfCustodyVaultProvider — both hold the private key in this application.
# Real CDP Server Wallet custody is roadmap P4-T1. See docs/SECURITY.md.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CHAIN=base-sepolia
# Optional RPC override for vault deposit detection / USDC transfers (defaults to public Base / Sepolia RPC)
# CHAIN_RPC_URL=https://sepolia.base.org
# Force ledger-only mock for 0x agent pays (offline demos only — breaks the E2E wallet proof)
# POLICYVAULT_MOCK_TRANSFER=1

# --- Telegram approvals (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user ids allowed to approve (empty = chat id only)
TELEGRAM_ALLOWED_USER_IDS=

# --- Notifications (optional; stubs log until set) ---
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
ABI_NOTIFY_EMAIL_TO=
ABI_NOTIFY_EMAIL_FROM=ABI <onboarding@resend.dev>

# --- Compliance ---
ABI_COMPLIANCE_DENYLIST=
ABI_COMPLIANCE_WEBHOOK_URL=
# ABI_COMPLIANCE_FAIL_CLOSED=1

# --- Observability ---
# ABI_OBS_SILENT=1

# --- Rate limits ---
RATE_LIMIT_PER_MIN=5000
APPROVAL_TTL_MINUTES=60

# --- Future A14 Postgres (Compose profile only; API still uses SQLite) ---
DATABASE_URL=postgresql://abi:abi@localhost:5432/policyvault
POSTGRES_PASSWORD=abi
